# Anthropic API Key for Claude content analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Docs Configuration (must be publicly shared - "Anyone with link can view")
GOOGLE_DOC_ID=your_google_doc_id_here

# News API Keys (optional - for better article search)
# Get free API key at: https://newsapi.org/
NEWSAPI_KEY=

# Bing News Search (optional - for better article search)
# Get free tier at: https://www.microsoft.com/en-us/bing/apis/bing-news-search-api
BING_SEARCH_KEY=

# Search Configuration
DEFAULT_KEYWORD=space technology
MAX_ARTICLES=5

# Social Media Settings
TWITTER_MAX_LENGTH=280
LINKEDIN_MAX_LENGTH=3000
